# AI / geometry worker settings (copy to services/ai-worker/.env)
WORKER_HOST=127.0.0.1
WORKER_PORT=8000
# Must equal AI_WORKER_TOKEN in the API's .env
AI_WORKER_TOKEN=replace-with-same-secret
WORKER_DATA_DIR=./data
MODEL_CACHE_DIR=./model-cache
# Sking: full SKING_DDJ_v101c bundle directory (see docs/MODELS_AND_LICENSES.md)
SKING_DIR=./models/Sking/SKING_DDJ_v101c
# Python interpreters with Sking's parser / foreground dependencies (CUDA PyTorch). Empty = not configured.
SKING_PARSER_PYTHON=
SKING_FOREGROUND_PYTHON=
SKING_TIMEOUT_S=600
# TripoSR: official repo checkout + a Python with its requirements
TRIPOSR_DIR=./models/TripoSR
TRIPOSR_PYTHON=
TRIPOSR_MODEL=./models/TripoSR-weights
TRIPOSR_DEVICE=auto
TRIPOSR_TIMEOUT_S=1800
ENABLE_SKING=false
ENABLE_TRIPOSR=false
CUDA_VISIBLE_DEVICES=0
MAX_CONCURRENT_GPU_JOBS=1
MAX_UPLOAD_MB=40
JOB_TTL_S=21600
