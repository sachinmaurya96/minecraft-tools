{
  "name": "@blockwright/bedrock-export",
  "version": "0.1.0",
  "private": true,
  "description": "Bedrock entity add-on builder: cuboid model -> atlas, .geo.json, client/behavior entity, manifests; plus structural validators.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@blockwright/shared": "0.1.0"
  },
  "devDependencies": {
    "@blockwright/minecraft-skin": "0.1.0"
  }
}
