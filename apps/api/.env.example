# API settings (copy to apps/api/.env or ./.env). Never prefix secrets with VITE_.
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
API_HOST=127.0.0.1
API_PORT=4000
# Relative paths resolve from the API process working directory (apps/api when run via npm workspaces)
DATA_DIR=./data
MAX_IMAGE_MB=10
MAX_IMAGE_PIXELS=20000000
MAX_IMAGES_PER_PROJECT=4
MAX_MESH_MB=25
MAX_RUNNING_JOBS=1
MAX_QUEUED_JOBS=10
MAX_JOBS_PER_SESSION=2
JOB_TIMEOUT_S=900
PROJECT_TTL_HOURS=24
AI_WORKER_URL=http://127.0.0.1:8000
# Long random secret shared with services/ai-worker/.env (generate: openssl rand -hex 32)
AI_WORKER_TOKEN=replace-with-long-random-secret
# Only set true after the official model inference has been verified on this server's hardware
ENABLE_SKING=false
ENABLE_TRIPOSR=false
# Signs anonymous session tokens (>= 32 chars). If unset, a random one is generated into DATA_DIR/secret.
SESSION_SECRET=
# Optional: serve the built web app from the API (single-origin deployment)
# SERVE_WEB_DIST=../web/dist
# TRUST_PROXY=1
RATE_LIMIT_WINDOW_S=60
RATE_LIMIT_MAX=300
UPLOAD_RATE_LIMIT_MAX=30
JOB_RATE_LIMIT_MAX=10
LOG_LEVEL=info
